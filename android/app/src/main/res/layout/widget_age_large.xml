<?xml version="1.0" encoding="utf-8"?>
<!-- 4 × 4 — the full perspective: hero age, live seconds, month rail, life line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/age_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:contentDescription="@string/age_widget_description"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/age_widget_label"
            style="@style/WidgetType.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AGE IN MOTION"
            android:textSize="9sp" />

        <ImageView
            android:id="@+id/age_widget_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_now_dark" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/age_widget_years"
            style="@style/WidgetType.Dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="26"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/age_widget_unit"
            style="@style/WidgetType.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_marginBottom="9dp"
            android:layout_weight="1"
            android:text="YEARS"
            android:textSize="11sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/age_widget_elapsed"
        style="@style/WidgetType.Dot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:text="12:00:00"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/age_widget_details"
        style="@style/WidgetType.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="04 MONTHS · 12 DAYS"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/age_widget_rail_label"
            style="@style/WidgetType.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="MONTHS"
            android:textSize="8sp" />

        <include
            layout="@layout/widget_rail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/age_widget_life"
        style="@style/WidgetType.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textSize="10sp" />
</LinearLayout>
