<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/age_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/age_widget_description"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/widget_red"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/age_widget_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="AGE IN MOTION"
            android:textColor="@color/widget_muted"
            android:textSize="10sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/age_widget_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textColor="@color/widget_red"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/age_widget_years"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:text="—"
            android:textColor="@color/widget_text"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="sans-serif"
            android:text="YEARS"
            android:textColor="@color/widget_muted"
            android:textSize="9sp"
            android:letterSpacing="0.12" />

        <Chronometer
            android:id="@+id/age_widget_elapsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="end"
            android:includeFontPadding="false"
            android:text="00:00:00"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/age_widget_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="sans-serif"
        android:text="00 months  •  00 days"
        android:textColor="@color/widget_muted"
        android:textSize="10sp"
        android:letterSpacing="0.05" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:background="@color/widget_red" />

</LinearLayout>
