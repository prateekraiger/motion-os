<?xml version="1.0" encoding="utf-8"?>
<!-- 2 × 2 — the signature square: label, hero number, live seconds, month rail. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/age_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:contentDescription="@string/age_widget_description"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/age_widget_label"
            style="@style/WidgetType.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AGE IN MOTION"
            android:textSize="9sp" />

        <ImageView
            android:id="@+id/age_widget_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_now_dark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/age_widget_years"
            style="@style/WidgetType.Dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="26"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/age_widget_unit"
            style="@style/WidgetType.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            android:text="YEARS"
            android:textSize="9sp" />

        <Chronometer
            android:id="@+id/age_widget_elapsed"
            style="@style/WidgetType.Dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:gravity="end|bottom"
            android:text="12:00:00"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/age_widget_details"
        style="@style/WidgetType.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="04 MONTHS · 12 DAYS"
        android:textSize="9sp" />

    <include
        layout="@layout/widget_rail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />
</LinearLayout>
