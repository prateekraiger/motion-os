<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tactile feedback on completions and taps. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- On-device dictation for quick capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Read-only calendar overlay on Today and the planner. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Interactive focus / reminder notifications (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reminders must be able to wake the device to fire on time. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              "Share to Motion OS": text shared from any app lands in quick
              capture as a task. singleTask + onNewIntent keeps a second share
              from stacking activities.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Quick Settings tile: start a 25-minute focus block. -->
            <intent-filter>
                <action android:name="io.motionos.app.ACTION_START_FOCUS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile (notification shade). -->
        <service
            android:name=".FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_motion"
            android:label="@string/focus_tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Focus / reminder notification actions. -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- Native home-screen widgets. Exported is required so the launcher can discover them. -->
        <!--
          TIME_SET / TIMEZONE_CHANGED / LOCALE_CHANGED are exempt from the
          Android 8 implicit-broadcast restriction, so a manifest receiver may
          still listen for them: they keep the live counters honest when the
          system clock, zone or locale changes. ACTION_WIDGET_DAY_ROLL is our
          own (inexact alarm) broadcast that flips the day counters at midnight.
        -->
        <receiver android:name=".AgeWidgetProvider" android:exported="true" android:label="@string/age_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="io.motionos.app.ACTION_WIDGET_DAY_ROLL" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/age_widget_info" />
        </receiver>

        <receiver android:name=".YearWidgetProvider" android:exported="true" android:label="@string/year_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="io.motionos.app.ACTION_WIDGET_DAY_ROLL" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/year_widget_info" />
        </receiver>

        <receiver android:name=".WidgetPinReceiver" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
